{
  "name": "volsurface",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-engine": "bun run scripts/sync-engine.ts",
    "sync-engine:check": "bun run scripts/sync-engine.ts --check",
    "check:autonomy": "bun run scripts/check-autonomy.ts",
    "test:engine": "cd engine && bun run test",
    "test:backend": "cd backend && bun run test",
    "typecheck:engine": "cd engine && bun run typecheck",
    "typecheck:backend": "cd backend && bun run typecheck",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "verify": "bun run lint && bun run sync-engine:check && bun run check:autonomy && bun run typecheck:engine && bun run typecheck:backend && bun run test:engine && bun run test:backend"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "1.3.11"
  }
}
