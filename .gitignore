# claude config (local only)
.claude/
CLAUDE.md

# local planning docs (never pushed)
docs/

# generated engine copies (canonical source is /engine, synced via scripts/sync-engine.ts)
backend/src/engine/
frontend/src/engine/

# dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# builds. anchored to each service root on purpose: a bare "**/build/" also
# matches source directories named build, which silently drops them from both
# git and tailwind's source scan.
/dist/
/build/
/out/
.next/
*/dist/
*/build/
*/out/

# env
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# test + verification artifacts
coverage/
**/coverage/
e2e/screenshots/
**/e2e/screenshots/
playwright-report/
test-results/

# the full screen tour is for reviewing the app, not for shipping. the readme's
# own images live in frontend/public/readme and are committed.
**/public/tour/

# logs
*.log
npm-debug.log*
bun-debug.log*

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# bun / package managers
.turbo/
