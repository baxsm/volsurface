{
  "name": "volsurface-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "worker": "bun src/jobs/worker.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.26",
    "better-auth": "1.6.26",
    "bullmq": "6.0.10",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "ioredis": "6.0.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
