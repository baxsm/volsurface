NODE_ENV=development
PORT=3007
DATABASE_URL=postgres://user:password@localhost:5436/volsurface
REDIS_URL=redis://localhost:6382

# frontend origin allowed through CORS with credentials
WEB_ORIGIN=http://localhost:5173

# 32+ characters. generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3007

# "lax" when the web host rewrites /api to this service, which is the default
# and keeps the session cookie first-party. "none" only when the api answers on
# its own domain: it needs https, and safari blocks it as a third-party cookie.
COOKIE_SAME_SITE=lax

# market data vendor. server-side only, never exposed to the browser
ALPHA_VANTAGE_API_KEY=

# "fixture" reads the committed chain, "alphavantage" calls the live API
MARKET_DATA_SOURCE=fixture

# guards the internal backfill trigger. unset disables the route
OPS_TOKEN=
